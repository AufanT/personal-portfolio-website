# ---------------------------------------------------------------------
# Contoh environment. Copy ke .env.local untuk pengembangan lokal, dan
# isi nilai yang sama di "Environment Variables" Node app di hPanel
# untuk produksi. JANGAN commit .env.local.
# ---------------------------------------------------------------------

# Database MySQL dari hPanel > Databases > Management.
# Di server Hostinger, aplikasi dan database berada di mesin yang sama,
# jadi DB_HOST = localhost dan tidak perlu mengaktifkan remote access.
# Untuk menjalankan script dari laptop, pakai host remote MySQL milik
# hosting dan daftarkan IP kamu dulu di hPanel > Remote MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u268020417_xxxxx
DB_PASSWORD=
DB_NAME=u268020417_xxxxx

# Kunci penanda tangan cookie session admin. Minimal 32 karakter.
# Generate dengan: node scripts/generate-secret.mjs
# Mengganti nilai ini akan memaksa login ulang di semua perangkat.
SESSION_SECRET=

# URL publik situs. Dipakai untuk metadata Open Graph dan sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://aufan.ifportofolio.com

# Token webhook deploy yang dipanggil GitHub Actions (POST /api/deploy).
# Hanya diperlukan di server, bukan saat pengembangan lokal.
DEPLOY_WEBHOOK_SECRET=
